@model IEnumerable<Movie>

<h2>Lista filmów</h2>
<table class="table">
    <tr>
        <th>ID</th>
        <th>Tytuł</th>
        <th>Gatunek</th>
        <th>Rok</th>
    </tr>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Id</td>
            <td>@movie.Title</td>
            <td>@movie.Genre</td>
            <td>@movie.Year</td>
        </tr>
    }
</table>

<a asp-action="Create" class="btn btn-primary">Dodaj nowy film</a>